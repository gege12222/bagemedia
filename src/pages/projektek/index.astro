---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  projects,
  categoryOrder,
  categoryLabels,
  getProjectsByCategory,
  statusColor,
  type Category,
} from '../../data/projects';
---

<BaseLayout
  title="Projektek"
  description="BageMedia projektek – mobil appok, üzleti rendszerek, weboldalak. Flutter, Firebase, Astro."
>
  <section class="section page-header">
    <div class="container content-narrow">
      <h1 class="section-title">Projektek</h1>
      <p class="section-subtitle">
        Szoftver, app és web projektek – ügyfélmunkák és saját fejlesztések.
      </p>
    </div>
  </section>

  <section class="section projects-body">
    <div class="container">
      {categoryOrder.map((cat) => {
        const items = getProjectsByCategory(cat);
        if (items.length === 0) return null;
        return (
          <div class="category-section">
            <h2 class="category-title">{categoryLabels[cat]}</h2>
            <div class="grid-3">
              {items.map((p) => (
                <a href={`/projektek/${p.slug}`} class="card project-card">
                  {p.coverImage ? (
                    <img src={p.coverImage} alt={p.title} class="card-cover" loading="lazy" width="860" height="400" />
                  ) : (
                    <div class="img-placeholder">{p.platforms.join(' · ')}</div>
                  )}
                  <div class="project-meta">
                    <span class="status-badge" style={`--status-color: ${statusColor(p.status)}`}>
                      {p.status}
                    </span>
                    {p.platforms.map((pl) => (
                      <span class="platform-badge">{pl}</span>
                    ))}
                  </div>
                  <h3 class="card-title">{p.title}</h3>
                  <p class="card-text">{p.shortDescription}</p>
                  <div class="tech-tags">
                    {p.techTags.map((t) => (
                      <span class="tech-tag">{t}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <section class="section cta-section">
    <div class="container cta-content">
      <h2 class="cta-title">Szükséged van egyedi szoftverre vagy weboldalra?</h2>
      <p class="cta-text">Beszéljük meg a projektedet – írj bátran.</p>
      <a href="/kapcsolat" class="btn btn-primary">Kapcsolat</a>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-body {
    padding-top: var(--space-2xl);
  }

  .category-section {
    margin-bottom: var(--space-3xl);
  }

  .category-title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-border);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--status-color) 14%, transparent);
    color: var(--status-color);
  }

  .status-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-color);
  }

  .platform-badge {
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    background: var(--color-dark);
    color: #ccc;
    font-weight: 500;
  }

  .tech-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: var(--space-md);
  }

  .tech-tag {
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    background: var(--color-accent-light);
    color: var(--color-accent);
    border: 1px solid transparent;
    font-weight: 500;
  }

  /* CTA */
  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, var(--color-accent-light) 0%, var(--color-bg) 100%);
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .cta-title {
    font-size: var(--text-3xl);
  }

  .cta-text {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    max-width: 480px;
  }
</style>
