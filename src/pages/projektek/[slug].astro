---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, statusColor, categoryLabels } from '../../data/projects';
import type { Project } from '../../data/projects';
import type { GetStaticPaths } from 'astro';

interface Props {
  project: Project;
}

export const getStaticPaths: GetStaticPaths = () => {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
};

const { project } = Astro.props;
const cs = project.caseStudy;
---

<BaseLayout
  title={project.title}
  description={project.shortDescription}
>
  <!-- BREADCRUMB -->
  <section class="breadcrumb-bar">
    <div class="container">
      <nav aria-label="Útvonal">
        <a href="/projektek">← Projektek</a>
      </nav>
    </div>
  </section>

  <!-- HERO -->
  <section class="section project-hero">
    <div class="container">
      <div class="hero-meta">
        <span class="status-badge" style={`--status-color: ${statusColor(project.status)}`}>
          {project.status}
        </span>
        <span class="cat-label">{categoryLabels[project.category]}</span>
      </div>

      <h1 class="project-title">{project.title}</h1>
      <p class="project-summary">{cs ? cs.summary : project.shortDescription}</p>

      <div class="hero-meta-row">
        <div class="badge-group">
          <span class="badge-label">Platform</span>
          <div class="badges">
            {project.platforms.map((pl) => (
              <span class="platform-badge">{pl}</span>
            ))}
          </div>
        </div>
        <div class="badge-group">
          <span class="badge-label">Technológiák</span>
          <div class="badges">
            {project.techTags.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </div>
        {(project.externalLinks || project.downloads) && (
          <div class="badge-group">
            <span class="badge-label">Linkek</span>
            <div class="badges">
              {project.externalLinks?.website && (
                <a href={project.externalLinks.website} target="_blank" rel="noopener" class="ext-link">
                  <svg class="ext-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  Weboldal
                </a>
              )}
              {project.externalLinks?.appStore && (
                <a href={project.externalLinks.appStore} target="_blank" rel="noopener" class="ext-link">
                  <svg class="ext-icon" viewBox="0 0 384 512" fill="currentColor"><path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184 4 270.2c0 26.9 4.9 54.8 14.6 83.6 12.9 38.2 59.5 131.8 107.9 130.2 24.9-.7 42.5-17.8 75.1-17.8 31.5 0 47.8 17.8 76.4 17.8 48.8-.8 90.8-110.3 103.2-148.6-65.3-30.7-66.5-90-66.5-66.7zm-56.9-168C287 75 310.4 37.3 306.8 0 275.2 1.6 238 21.5 213.2 48.2c-23.1 24.8-43.3 63.9-37.6 101.3 34.3 2.5 66-17.3 86.2-48.8z"/></svg>
                  App Store{project.downloads?.appStore && <span class="dl-count">{project.downloads.appStore}</span>}
                </a>
              )}
              {project.externalLinks?.googlePlay && (
                <a href={project.externalLinks.googlePlay} target="_blank" rel="noopener" class="ext-link">
                  <svg class="ext-icon" viewBox="0 0 512 512" fill="currentColor"><path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z"/></svg>
                  Google Play{project.downloads?.googlePlay && <span class="dl-count">{project.downloads.googlePlay}</span>}
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  {cs && (
    <>
      {/* PROBLEM */}
      <section class="section">
        <div class="container case-content">
          <h2>Probléma</h2>
          <p>{cs.problem}</p>
        </div>
      </section>

      {/* SOLUTION */}
      <section class="section section-alt">
        <div class="container case-content">
          <h2>Megoldás</h2>
          <ul class="feature-list">
            {cs.solutionBullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      </section>

      {/* ROLE */}
      <section class="section">
        <div class="container case-content">
          <h2>Szerepem</h2>
          <p>{cs.role}</p>
        </div>
      </section>

      {/* TECH STACK */}
      <section class="section section-alt">
        <div class="container case-content">
          <h2>Tech stack</h2>
          <div class="stack-list">
            {cs.stack.map((s) => (
              <div class="stack-item">
                <span class="stack-dot"></span>
                {s}
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* RESULTS */}
      <section class="section">
        <div class="container case-content">
          <h2>Eredmény</h2>
          <p>{cs.results}</p>
        </div>
      </section>

      {/* SCREENSHOTS */}
      {cs.screenshots && cs.screenshots.length > 0 && (
        <section class="section section-alt">
          <div class="container case-content">
            <h2>Képernyőképek</h2>
            {cs.privacyNote && (
              <p class="privacy-note">{cs.privacyNote}</p>
            )}
            <div class="screenshots-grid">
              {cs.screenshots.map((label) => (
                <div class="screenshot-item">
                  <div class="img-placeholder img-portrait">{label}</div>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </>
  )}

  {/* CTA */}
  <section class="section cta-section">
    <div class="container cta-content">
      <h2 class="cta-title">Kérj hasonló megoldást</h2>
      <p class="cta-text">Ha neked is szükséged van egyedi szoftverre vagy weboldalra, keress bátran.</p>
      <a href="/kapcsolat" class="btn btn-primary">Kapcsolat</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* BREADCRUMB */
  .breadcrumb-bar {
    padding-top: var(--space-xl);
  }

  .breadcrumb-bar a {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 500;
    transition: opacity var(--transition);
  }

  .breadcrumb-bar a:hover {
    opacity: 0.7;
  }

  /* HERO */
  .project-hero {
    padding-bottom: var(--space-xl);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .cat-label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    background: color-mix(in srgb, var(--status-color) 14%, transparent);
    color: var(--status-color);
  }

  .status-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-color);
  }

  .project-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-lg);
  }

  @media (min-width: 768px) {
    .project-title {
      font-size: var(--text-4xl);
    }
  }

  .project-summary {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 700px;
    line-height: 1.8;
    margin-bottom: var(--space-xl);
  }

  .hero-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-xl);
  }

  .badge-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .badges {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .platform-badge {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    background: var(--color-dark);
    color: #ccc;
    font-weight: 500;
  }

  .tech-tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    background: var(--color-accent-light);
    color: var(--color-accent);
    font-weight: 500;
  }

  /* LINKS */
  .ext-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    transition: background 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  .ext-link:hover {
    background: var(--color-accent-light);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .ext-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .dl-count {
    opacity: 0.5;
    margin-left: 0.15rem;
  }

  .dl-count::before {
    content: '\00b7 ';
  }

  /* CASE STUDY */
  .case-content {
    max-width: 760px;
  }

  .case-content h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-lg);
  }

  .case-content p {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .section-alt {
    background: var(--color-accent-light);
  }

  /* Features */
  .feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .feature-list li {
    position: relative;
    padding-left: var(--space-xl);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Stack */
  .stack-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .stack-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    color: var(--color-text-secondary);
  }

  .stack-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* Screenshots */
  .privacy-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-xl);
  }

  .screenshots-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  @media (min-width: 640px) {
    .screenshots-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .img-portrait {
    aspect-ratio: 9/16;
  }

  /* CTA */
  .cta-section {
    text-align: center;
    background: linear-gradient(135deg, var(--color-accent-light) 0%, var(--color-bg) 100%);
  }

  .cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .cta-title {
    font-size: var(--text-3xl);
  }

  .cta-text {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    max-width: 480px;
  }
</style>
