---
import { tori24Links } from '../data/tori24';

const { showTori24Links = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  {showTori24Links && (
    <nav class="container tori24-footer" aria-label="Töri24 lábléc">
      <ul class="footer-inner">
        {tori24Links.map(({ href, label }) => <li><a href={href} class="footer-link">{label}</a></li>)}
      </ul>
    </nav>
  )}
  <div class="container footer-inner">
    <a href="/" class="footer-logo">Bage<strong>Media</strong></a>
    <span class="footer-sep">·</span>
    <a href="mailto:hello@bagemedia.hu" class="footer-link">hello@bagemedia.hu</a>
    <span class="footer-sep">·</span>
    <p class="footer-copy">&copy; {year} BageMedia</p>
    <span class="footer-sep">·</span>
    <a href="/impresszum" class="footer-link">Impresszum</a>
    <span class="footer-sep">·</span>
    <a href="/aszf" class="footer-link">ÁSZF</a>
    <span class="footer-sep">·</span>
    <a href="/adatkezeles" class="footer-link">Adatkezelés</a>
  </div>
</footer>

<style>
  .tori24-footer {
    margin-bottom: var(--space-md);
  }

  .tori24-footer .footer-link {
    display: inline-block;
    padding-block: var(--space-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer {
    background: var(--color-dark);
    color: #888;
    padding-block: var(--space-xl);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
  }

  .footer-logo {
    color: #fff;
    text-decoration: none;
    font-size: var(--text-base);
  }

  .footer-logo strong {
    color: var(--color-accent);
  }

  .footer-sep {
    color: #444;
  }

  .footer-link {
    color: #999;
    transition: color var(--transition);
  }

  .footer-link:hover {
    color: #fff;
  }

  .footer-copy {
    color: #888;
    margin: 0;
  }
</style>
