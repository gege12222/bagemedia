---
import BaseLayout from './BaseLayout.astro';
import { tori24, tori24Links } from '../data/tori24';

interface Props {
  title: string;
  description: string;
  landing?: boolean;
  draft?: boolean;
}

const { title, description, landing = false, draft = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---

<BaseLayout title={title} description={description} ogImage={tori24.coverImage} showTori24Links>
  <div class="app-navigation">
    <nav class="container" aria-label="Töri24 navigáció">
      <ul>
        {tori24Links.map(({ href, label }) => (
          <li><a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  {landing ? (
    <slot />
  ) : (
    <article class="container content-narrow document">
      <header>
        <h1 class="section-title">{title}</h1>
        {draft && <p class="draft"><strong>Felülvizsgálandó tervezet.</strong> A TODO-jelölések a véglegesítéshez szükséges adatokat mutatják.</p>}
      </header>
      <slot />
    </article>
  )}
</BaseLayout>

<style>
  .app-navigation {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-lg);
    padding-block: var(--space-xs);
  }

  nav a {
    display: inline-block;
    padding-block: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  nav a[aria-current='page'] {
    font-weight: 600;
  }

  .document {
    padding-block: var(--space-2xl) var(--space-3xl);
    overflow-wrap: anywhere;
  }

  .document :global(h2) {
    margin-block: var(--space-2xl) var(--space-sm);
    font-size: var(--text-xl);
    scroll-margin-top: calc(var(--header-height) + var(--space-md));
  }

  .document :global(h3) {
    margin-block: var(--space-lg) var(--space-sm);
    font-size: var(--text-lg);
  }

  .document :global(p),
  .document :global(ul),
  .document :global(ol) {
    margin-bottom: var(--space-md);
    color: var(--color-text-secondary);
  }

  .document :global(ul),
  .document :global(ol) {
    padding-inline-start: var(--space-lg);
  }

  .document :global(ul) { list-style: disc; }
  .document :global(ol) { list-style: decimal; }

  .document :global(a) {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .document :global(.draft),
  .document :global(.todo) {
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: var(--color-accent-light);
    color: var(--color-text);
    padding: var(--space-sm) var(--space-md);
  }
</style>
